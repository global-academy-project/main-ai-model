### OPEN | CLOSED
NETWORK_ENV=

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=YOUR_OPENAI_API_MODEL

AI_TIMEOUT_SECONDS=MAX_AI_LATENCY
### 50000~100000 사이 권장
AI_MAX_OUTPUT_TOKENS=MAX_TOKENS_TO_USE

### MOCK | "SPRING"
CHECK_RULES_TOOL=
### CHECK_RULES_TOOL가 SPRING일 경우 하단 두 변수 필수 입력
INTERNAL_API_BASE_URL=
# E 기록질문은 Spring 요청 헤더를 전달하므로 이 값이 필요하지 않다.
INTERNAL_API_TOKEN=
INTERNAL_API_CONNECT_TIMEOUT_SECONDS=5
INTERNAL_API_READ_TIMEOUT_SECONDS=300

### 기록질문 실행 시 Spring 내부 기록 도구 주소
### 기본값: http://127.0.0.1:8080
